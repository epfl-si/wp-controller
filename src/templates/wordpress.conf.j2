{# Managed by wp-controller - DO NOT EDIT MANUALLY #}

server {
    listen 8080 default_server;
    server_name _;

    location /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        return 404;
    }
}
{% for hostname, sites in hosts %}
server {
    listen 8080;
    server_name {{ hostname }};

    error_page 403 404 500 502 503 504 /global-error/index.php;

    location /global-error/ {
        set $status_code $status;

        if ($query_string ~* "status=(\d+)") {
            set $status_code $1;
        }

        if ($uri ~* "/([^/]+)/(\d+)\.php$") {
            set $status_code $2;
        }

        fastcgi_param STATUS          $status_code;
        fastcgi_param SCRIPT_FILENAME /wp/wp-error-pages/index.php;
        fastcgi_param QUERY_STRING    $query_string;
        fastcgi_param REQUEST_METHOD  $request_method;
        fastcgi_param REQUEST_URI     $request_uri;
        fastcgi_pass unix:/run/php-fpm/php-fpm.sock;
    }
{% set ns = namespace(has_root_location=false) %}
{% for site in sites %}
    ####################### START LOCATION #######################

    # ------------------------------------------------------------- #
    # Namespace      : "{{ site.namespace }}";
    # WordpressSite  : "{{ site.name }}";
    # Hostname       : "{{ site.hostname }}";
    # Path           : "{{ site.path }}";
    # ------------------------------------------------------------- #

{% if site.path == "/" %}
{% set ns.has_root_location = true %}
    location /robots.txt {
        fastcgi_pass unix:/run/php-fpm/php-fpm.sock;
    }
{% endif %}
    location {{ site.root_uri }} {
        include {{ fastcgi_include_path }};
        {# Default handler: whatever no nested location below claims (e.g. a
           missing file, or a URL with a dot in its last segment) goes to
           WordPress, which answers with its own real 404. #}
        fastcgi_pass unix:/run/php-fpm/php-fpm.sock;

        location ~ (wp-content/uploads)/ {
{% if site.protection_script %}
            fastcgi_pass unix:/run/php-fpm/php-fpm.sock;
{% else %}
            rewrite .*/(wp-content/uploads/(.*)) /$2 break;
            root {{ uploads_root }}/{{ site.uploads_dirname }}/uploads;
            add_header Cache-Control "129600, public";
{% endif %}
        }

        location = {{ site.root_uri }}wp-admin {
            return 301 https://{{ hostname }}{{ site.root_uri }}wp-admin/;
        }

        location ~ {{ static_whitelist_re }} {
            rewrite .*/({{ static_whitelist_re }}.*) /$1 break;
            root /wp/;

            location ~* \.(ico|pdf|apng|avif|webp|jpg|jpeg|png|gif|svg)$ {
                add_header Cache-Control "129600, public";
                rewrite .*/({{ static_whitelist_re }}.*) /$1 break;
                }
        }

        fastcgi_param WP_DEBUG           {{ "true" if site.debug else "false" }};
        fastcgi_param WP_ROOT_URI        {{ site.root_uri }};
        fastcgi_param WP_UPLOADS_DIRNAME  {{ site.uploads_dirname }};
        fastcgi_param WP_DB_HOST         {{ site.db.host|nginx_quote }};
        fastcgi_param WP_DB_NAME         {{ site.db.name|nginx_quote }};
        fastcgi_param WP_DB_USER         {{ site.db.user|nginx_quote }};
        fastcgi_param WP_DB_PASSWORD     {{ site.db.password|nginx_quote }};
{% if site.protection_script %}
        fastcgi_param DOWNLOADS_PROTECTION_SCRIPT {{ site.protection_script|nginx_quote }};
{% endif %}
    }

    ######################## END LOCATION ########################
{% if not site.path.endswith("/") %}

    ####################### START LOCATION #######################

    # ------------------------------------------------------------- #
    # Namespace      : "{{ site.namespace }}";
    # WordpressSite  : "{{ site.name }}";
    # Hostname       : "{{ site.hostname }}";
    # Path           : "{{ site.path }}";
    # ------------------------------------------------------------- #

    {# Relative links in the rendered HTML break without the canonical
       trailing slash, so redirect the exact near-miss URL to it. #}
    location = {{ site.path }} {
        return 301 https://{{ hostname }}{{ site.path }}/;
    }

    ######################## END LOCATION ########################
{% endif %}
{% endfor %}
{% if not ns.has_root_location %}
    # Catch-all in the (unlikely) case where there is no WordPress at
    # the root of the domain:
    location / {
        return 404;
    }
{% endif %}
}
{% endfor %}
